{
  "name": "dsh-vibrancy-skin",
  "version": "1.6.1",
  "description": "macOS native vibrancy (frosted glass) material for the DSH NEXT / DSH Desktop main pane and third-party sidebars, with a native Settings section. Material only — zero layout changes.",
  "license": "MIT",
  "author": "Natasha123-bit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Natasha123-bit/dsh-vibrancy-skin.git"
  },
  "homepage": "https://github.com/Natasha123-bit/dsh-vibrancy-skin#readme",
  "bugs": {
    "url": "https://github.com/Natasha123-bit/dsh-vibrancy-skin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "vibrancy",
    "frosted-glass",
    "macos"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "manifestVersion": 1
  }
}
